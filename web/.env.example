# Leave all four unset to run the storefront in demo mode (the shop lives in the visitor's browser).
# Set all four to talk to the real Go services; each is the base URL of that service.
SHOP_AUTH_URL=http://localhost:8091
SHOP_CART_URL=http://localhost:8092
SHOP_PRODUCT_URL=http://localhost:8093
SHOP_ORDER_URL=http://localhost:8094
