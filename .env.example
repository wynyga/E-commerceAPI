# Used by docker-compose.yml. Copy to .env (git-ignored) and replace every value.
# Generate secrets with:  openssl rand -hex 32

MYSQL_ROOT_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too

# Both must be at least 32 characters. INTERNAL_KEY guards the service-to-service stock calls.
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
INTERNAL_KEY=replace-with-another-long-random-secret-32-chars-plus

# The first admin (can create/edit/delete products), created on startup if missing.
ADMIN_EMAIL=admin@shop.test
ADMIN_PASSWORD=change-me-admin

# Optional
# AUTH_PORT=8091
# CART_PORT=8092
# PRODUCT_PORT=8093
# ORDER_PORT=8094
# AUTH_RATE_PER_MINUTE=10
